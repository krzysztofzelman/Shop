@page "/products"
@rendermode InteractiveServer
@inject HttpClient Http
@inject AuthState Auth

<PageTitle>@Lang.T("Products")</PageTitle>

<h1>@Lang.T("Products")</h1>

@if (!Auth.IsLoggedIn)
{
    <div class="alert alert-warning">
        @Lang.T("LoginRequired")
        <a href="/login">@Lang.T("SignIn")</a>
    </div>
}
else
{
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-2">
                <div class="col-md-3">
                    <input @bind="name" placeholder="@(Lang.T("Name"))" class="form-control" />
                </div>
                <div class="col-md-3">
                    <input @bind="quantity" placeholder="@(Lang.T("Quantity"))" class="form-control" />
                </div>
                <div class="col-md-3">
                    <input @bind="price" placeholder="@(Lang.T("Price"))" class="form-control" />
                </div>
                <div class="col-md-3">
                    <button class="btn btn-primary" @onclick="AddProduct">@(editingId == 0 ? Lang.T("Add") : Lang.T("Save"))</button>
                    <button class="btn btn-secondary" @onclick="Cancel">@Lang.T("Cancel")</button>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger">@error</div>
    }

    @if (products == null)
    {
        <p><em>@Lang.T("Loading")</em></p>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>@Lang.T("Name")</th>
                    <th>@Lang.T("Quantity")</th>
                    <th>@Lang.T("Price")</th>
                    <th>@Lang.T("Total")</th>
                    <th>@Lang.T("Gross")</th>
                    <th>@Lang.T("Actions")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in products)
                {
                    <tr>
                        <td>@product.Id</td>
                        <td>@product.Name</td>
                        <td>@product.Quantity</td>
                        <td>@product.Price zł</td>
                        <td>@(product.Quantity * product.Price) zł</td>
                        <td>@decimal.Round(product.Price * 1.23m, 2) zł</td> 
                        <td>
                            <button class="btn btn-danger btn-sm" @onclick="() => DeleteProduct(product.Id)">@Lang.T("Delete")</button>
                            <button class="btn btn-warning btn-sm" @onclick="() => EditProduct(product)">@Lang.T("Edit")</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <p>@Lang.T("Sum"): @ProductsSum() zł</p>
    }
}

@code {
    private List<Product>? products;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsLoggedIn)
        {
            return;
        }

        products = await Http.GetFromJsonAsync<List<Product>>("api/Product");
    }
    private decimal ProductsSum()
    {
        if (products == null)
        {
            return 0;
        }

        decimal total = 0;
        foreach (var product in products)
        {
            total = total + product.Quantity * product.Price;
        }
        return total;
    }

    private string name = "";
    private int quantity;
    private string price = "";
    private int editingId;
    private string? error;

    private async Task AddProduct()
    {
        var newProduct = new Product
        {
            Name = name,
            Quantity = quantity,
            Price = decimal.Parse(price.Replace(',','.'), System.Globalization.CultureInfo.InvariantCulture)
        };
        HttpResponseMessage response;
        if (editingId == 0)
        {
            response = await Http.PostAsJsonAsync("api/Product", newProduct);
        }
        else
        {
            response = await Http.PutAsJsonAsync($"api/Product/{editingId}", newProduct);
        }
        if (!response.IsSuccessStatusCode)
        {
            await SetError(response);
            return;
        }

        error = null;
        products = await Http.GetFromJsonAsync<List<Product>>("api/Product");
    }

    private void EditProduct(Product product)
    {
        name = product.Name;
        quantity = product.Quantity;
        price = product.Price.ToString(System.Globalization.CultureInfo.InvariantCulture);
        editingId = product.Id;
    }

    private async Task DeleteProduct(int id)
    {
        var response = await Http.DeleteAsync($"api/Product/{id}");
        if (!response.IsSuccessStatusCode)
        {
            await SetError(response);
        }
        else
        {
            error = null;
        }

        products = await Http.GetFromJsonAsync<List<Product>>("api/Product");
    }

    private void Cancel()
    {
        name = "";
        quantity = 0;
        price = "";
        editingId = 0;
    }

    private async Task SetError(HttpResponseMessage response)
    {
        error = await response.Content.ReadAsStringAsync();
        if (string.IsNullOrWhiteSpace(error) || error.StartsWith("{"))
        {
            error = "API Error: " + response.StatusCode;
        }
    }
}