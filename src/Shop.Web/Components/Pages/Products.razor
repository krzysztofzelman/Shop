@page "/products"
@rendermode InteractiveServer
@inject HttpClient Http

<PageTitle>Products</PageTitle>

<h1>Products</h1>

<div class="card mb-4">
    <div class="card-body">
        <div class="row g-2">
            <div class="col-md-3">
                <input @bind="name" placeholder="Name" class="form-control" />
            </div>
            <div class="col-md-3">
                <input @bind="quantity" placeholder="Quantity" class="form-control" />
            </div>
            <div class="col-md-3">
                <input @bind="price" placeholder="Price" class="form-control" />
            </div>
            <div class="col-md-3">
                <button class="btn btn-primary" @onclick="AddProduct">Dodaj</button>
            </div>
        </div>
    </div>

</div>

@if (products == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Quantity</th>
                <th>Price</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in products)
            {

                <tr>
                    <td>@product.Id</td>
                    <td>@product.Name</td>
                    <td>@product.Quantity</td>
                    <td>@product.Price zł</td>
                    <td>
                        <button class="btn btn-danger btn-sm" @onclick="() => DeleteProduct(product.Id)">Usuń</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Product>? products;

    protected override async Task OnInitializedAsync()
    {
        products = await Http.GetFromJsonAsync<List<Product>>("http://localhost:5143/api/Product");
    }

    private string name = "";
    private int quantity;
    private decimal price;

    private async Task AddProduct()
    {
        var newProduct = new Product
        {
            Name = name,
            Quantity = quantity,
            Price = price
        };
        await Http.PostAsJsonAsync("http://localhost:5143/api/Product", newProduct);
        products = await Http.GetFromJsonAsync<List<Product>>("http://localhost:5143/api/Product");
    }

    private async Task DeleteProduct(int id)
    {
        await Http.DeleteAsync($"http://localhost:5143/api/Product/{id}");
        products = await Http. GetFromJsonAsync<List<Product>>("http://localhost:5143/api/Product");
    }
}
