@page "/orders/{id:int}"
@rendermode InteractiveServer
@inject HttpClient Http

<PageTitle>@Lang.T("OrderDetails")</PageTitle>

<h1>@Lang.T("OrderDetails") @Id</h1>
<p><a href="/orders">@Lang.T("Orders")</a></p>

@if (items == null)
{
    <p><em>@Lang.T("Loading")</em></p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>@Lang.T("Product")</th>
                <th>@Lang.T("Quantity")</th>
                <th>@Lang.T("Price")</th>
                <th>@Lang.T("Total")</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in GroupedItems())
            {

                <tr>
                    <td>@ProductName(item.ProductId)</td>
                    <td>@item.Quantity</td>
                    <td>@item.Price zł</td>
                    <td>@(item.Quantity* item.Price) zł</td>
                </tr>
            }
        </tbody>
    </table>
    <p>@Lang.T("Sum"): @OrderSum() zł</p>
    <p>@Lang.T("Items"): @GroupedItems().Count</p>
}

@if (products != null)
{
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-2">
                <div class="col-md-4">
                    <select @bind="selectedProductId" class="form-control">
                        @foreach (var product in products)
                        {
                            <option value="@product.Id">@product.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <input @bind="quantity" placeholder="@(Lang.T("Quantity"))" class="form-control" />
                </div>
                <div class="col-md-4">
                    <button class="btn btn-primary" @onclick="AddItem">@Lang.T("Add")</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private List<OrderItem>? items;
    private List<Product>? products;

    private int selectedProductId = 3;
    private int quantity = 1;

    protected override async Task OnInitializedAsync()
    {
        items = await Http.GetFromJsonAsync<List<OrderItem>>($"http://localhost:5143/api/OrderItem/{Id}");
        products = await Http.GetFromJsonAsync<List<Product>>("http://localhost:5143/api/Product");
    }

    private string ProductName(int productId)
    {
        if (products == null)
        {
            return "";
        }
        foreach (var product in products)
        {
            if (product.Id == productId)
            {
                return product.Name;
            }
        }
        return "?";
    }

    private decimal OrderSum()
    {
        if (items == null)
        {
            return 0;
        }
        decimal total = 0;
        foreach (var item in items)
        {
            total = total + item.Quantity * item.Price;
        }
        return total;    
    }
    private List<OrderItem> GroupedItems()
    {
        var result = new List<OrderItem>();
        if (items == null)
        {
            return result;
        }
        foreach (var item in items)
        {
            bool found = false;
            foreach (var row in result)
            {
                if (row.ProductId == item.ProductId && row.Price == item.Price)
                {
                    row.Quantity = row.Quantity + item.Quantity;
                    found = true; }
            }

            if (found == false)
            {
                result.Add(new OrderItem { ProductId = item.ProductId, Quantity = item.Quantity, Price = item.Price });
            }
        }
        return result;
    }    
    private async Task AddItem()
    {
        var newItem = new OrderItem
            {
                OrderId = Id,
                ProductId = selectedProductId,
                Quantity = quantity,
                Price = ProductPrice(selectedProductId)
            };
        await Http.PostAsJsonAsync("http://localhost:5143/api/OrderItem", newItem);
        items = await Http.GetFromJsonAsync<List<OrderItem>>($"http://localhost:5143/api/OrderItem/{Id}");
    }
    private decimal ProductPrice(int productId)
    {
        if (products == null)
        {
            return 0;
        }
        foreach (var product in products)
        {
            if (product.Id == productId)
            {
                return product.Price;
            }
        }
        return 0;
    }
}
