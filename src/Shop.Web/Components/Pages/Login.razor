@page "/login"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components
@inject AuthState Auth
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>@Lang.T("Login")</PageTitle>

<h1>@Lang.T("Login")</h1>

<div class="card mb-4">
    <div class="card-body">
        <form @onsubmit="TryLogin" @onsubmit:preventDefault>
            <div class="row g-2">
                <div class="col-md-4">
                    <input @bind="login" placeholder="@(Lang.T("Login"))" class="form-control" />
                </div>
                <div class="col-md-4">
                    <input type="password" @bind="password" placeholder="@(Lang.T("Password"))" class="form-control" />
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary">@Lang.T("SignIn")</button>
                </div>
            </div>
        </form>

        @if (wrongPassword)
        {
            <p class="text-danger mt-2 mb-0">@Lang.T("WrongPassword")</p>
        }
    </div>
</div>

@code {
    private string login = "";
    private string password = "";
    private bool wrongPassword = false;

    private async Task TryLogin()
    {
        var response = await Http.PostAsJsonAsync("api/User/Login", new User { Login = login, Password = password });

        if (!response.IsSuccessStatusCode)
        {
            wrongPassword = true;
            return;
        }

        string token = await response.Content.ReadAsStringAsync();
        Auth.Token = token.Trim();
        Auth.IsLoggedIn = true;
        wrongPassword = false;
        Nav.NavigateTo("/products");
    }
}
